---
import "@shared/styles/index.css";
import { siteConfig } from "@shared/config/site";
import { AppProvider } from "../providers";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = siteConfig.name,
  description = siteConfig.description,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="icon" href="/favicon-dark.ico" type="image/x-icon" media="(prefers-color-scheme: dark)" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.author} />
    <meta name="keywords" content="OctalMesh, OctalLinks, OctalSocials, Links, Socials" />

    <!-- Canonical URL -->
    <link rel="canonical" href={siteConfig.canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={siteConfig.canonical} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script is:inline>
      document.documentElement.classList.replace("no-js", "js-enabled");
    </script>
  </head>
  <body class="flex flex-col font-sans antialiased">
    <AppProvider client:load>
      <slot />
    </AppProvider>

    <noscript>
      <div class="fixed top-0 left-0 w-full bg-red-500/10 text-red-500 text-[10px] text-center z-100 backdrop-blur-md py-1 font-mono uppercase tracking-widest">
        Enhanced experience requires JavaScript
      </div>
    </noscript>
  </body>
</html>
