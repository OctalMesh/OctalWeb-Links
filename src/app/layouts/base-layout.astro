---
import "../styles/index.css";
import { AppProvider } from "@app/providers";
import { siteConfig } from "@shared/config";
import { HeadAssets, HeadSeo } from "@shared/ui/head";
import { DEFAULT_LANGUAGE } from "@features/i18n";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  locale?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  description = siteConfig.description,
  image = siteConfig.image,
  type = "website",
  locale = DEFAULT_LANGUAGE,
  noindex = false,
  jsonLd,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, siteConfig.canonical).href.replace(/\/$/, "") || siteConfig.canonical;
---

<!doctype html>
<html lang={locale} class="no-js">
  <!--suppress HtmlRequiredTitleElement / Loaded in SEO component-->
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <HeadSeo
      title={title}
      description={description}
      image={image}
      type={type}
      canonical={canonical}
      locale={locale}
      noindex={noindex}
      jsonLd={jsonLd}
    />
    <HeadAssets />

    <script is:inline>
      document.documentElement.classList.replace("no-js", "js-enabled");
    </script>
  </head>
  <body class="flex flex-col font-sans antialiased">
    <div class="fixed h-screen w-full bg-[radial-gradient(ellipse_at_bottom,var(--fx-bg-start)_0%,var(--fx-bg-end)_100%)]" />

    <AppProvider client:idle>
      <main class="relative z-10"><slot /></main>
    </AppProvider>

    <noscript>
      <div class="fixed top-0 left-0 w-full bg-red-500/10 text-red-500 text-[10px] text-center z-100 backdrop-blur-md py-1 font-mono uppercase tracking-widest">
        Enhanced experience requires JavaScript
      </div>
    </noscript>
  </body>
</html>
