---
import { siteConfig } from "@shared/config";
import type { I18nConfig } from "@shared/lib/schema/i18n";

interface Props {
  i18n: I18nConfig;
  canonical: string;
}

const xDefault = siteConfig.canonical;
const { i18n, canonical } = Astro.props;
const alternates = i18n.languages.map((lang) => {
  const region = lang.region || lang.code.toLowerCase();
  return {
    code: `${lang.code.toLowerCase()}-${region.toLowerCase()}`,
    href: canonical.startsWith("http") ? canonical : `${siteConfig.canonical}${canonical}`
  };
});
---

{alternates.map(({ code, href }) => (
  <link rel="alternate" hreflang={code} href={href} />
))}
<link rel="alternate" hreflang="x-default" href={xDefault} />
