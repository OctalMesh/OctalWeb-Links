---
import BaseLayout from "@app/layouts/base-layout.astro";
import { DEFAULT_LANGUAGE, getTranslation } from "@features/i18n";
import { siteConfig } from "@shared/config";
import { buttonVariants } from "@shared/ui/button.constants";

const language = DEFAULT_LANGUAGE;

const translations = {
	badge: getTranslation("404.badge", language),
	errorLabel: getTranslation("404.error_label", language),
	title: getTranslation("404.title", language),
	description: getTranslation("404.description", language),
	primaryAction: getTranslation("404.primary_action", language),
	secondaryAction: getTranslation("404.secondary_action", language),
	consoleTitle: getTranslation("404.console_title", language),
	consoleSubtitle: getTranslation("404.console_subtitle", language),
	consolePath: getTranslation("404.console_path", language),
	consoleStatus: getTranslation("404.console_status", language),
	consoleHint: getTranslation("404.console_hint", language),
	quickExitTitle: getTranslation("404.quick_exit_title", language),
	quickExitBody: getTranslation("404.quick_exit_body", language),
};
---

<BaseLayout title={`404 | ${siteConfig.name}`} description={translations.description} noindex>
	<section class="relative isolate flex min-h-dvh items-center justify-center overflow-hidden px-6 py-16">
		<div class="relative grid w-full max-w-6xl gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
			<div class="scrollAnimated max-w-2xl space-y-8">
				<div class="inline-flex items-center gap-3 rounded-full border border-(--fx-card-border) bg-(--fx-card-bg) px-4 py-2 text-xs font-semibold uppercase tracking-[0.4em] text-(--fx-card-text) backdrop-blur-md">
					<span class="h-2 w-2 rounded-full bg-border-strong shadow-[0_0_24px_color-mix(in_oklch,var(--fx-bg-start)_45%,transparent)]" />
					<p data-i18n="404.badge">{translations.badge}</p>
				</div>

				<div class="space-y-4">
					<p class="font-mono text-sm uppercase tracking-[0.5em] text-(--fx-card-text)" data-i18n="404.error_label">
						{translations.errorLabel}
					</p>
					<h1 class="font-bold text-6xl leading-[0.88] tracking-[0.06em] drop-shadow-[0_24px_80px_rgba(0,0,0,0.55)] sm:text-7xl" data-i18n="404.title">
						{translations.title}
					</h1>
					<p class="max-w-xl text-balance text-lg leading-8 text-(--fx-card-text) sm:text-xl" data-i18n="404.description">
						{translations.description}
					</p>
				</div>

				<div class="flex flex-col gap-3 sm:flex-row sm:justify-center lg:justify-start">
					<a href="/" class={buttonVariants({ size: "lg" })} data-i18n="404.primary_action">
						{translations.primaryAction}
					</a>
					<button id="secondary-action" type="button" class={buttonVariants({ variant: "outline", size: "lg" })} data-i18n="404.secondary_action">
						{translations.secondaryAction}
					</button>
				</div>
			</div>

			<aside class="scrollAnimated delay-150 relative">
				<div class="absolute inset-0 rounded-4xl bg-[radial-gradient(circle_at_top,color-mix(in_oklch,var(--fx-bg-start)_16%,transparent)_0%,color-mix(in_oklch,var(--fx-bg-start)_4%,transparent)_38%,color-mix(in_oklch,var(--fx-bg-start)_2%,transparent)_68%,transparent_100%)] blur-2xl" />

				<div class="relative overflow-hidden rounded-4xl border border-(--fx-card-border) bg-(--fx-card-bg) p-6 shadow-[0_30px_120px_rgba(0,0,0,0.45)] backdrop-blur-2xl">
					<div class="flex items-center justify-between border-b border-(--fx-card-border) pb-4">
						<div>
							<p class="font-mono text-[10px] uppercase tracking-[0.45em] text-(--fx-card-text)" data-i18n="404.console_title">
								{translations.consoleTitle}
							</p>
							<p class="mt-2 text-sm text-(--fx-card-text)" data-i18n="404.console_subtitle">
								{translations.consoleSubtitle}
							</p>
						</div>
						<div class="flex gap-2">
							<span class="h-2.5 w-2.5 rounded-full bg-emerald-400/90 shadow-[0_0_16px_rgba(74,222,128,0.45)]" />
							<span class="h-2.5 w-2.5 rounded-full bg-amber-300/90 shadow-[0_0_16px_rgba(251,191,36,0.35)]" />
							<span class="h-2.5 w-2.5 rounded-full bg-rose-400/90 shadow-[0_0_16px_rgba(244,114,182,0.35)]" />
						</div>
					</div>

					<div class="mt-4">
						<div id="fake-terminal" class="w-full rounded-xl border border-(--fx-card-border) p-3">
							<div id="terminal-output" class="h-36 overflow-auto whitespace-pre-wrap wrap-break-word font-mono text-sm leading-6 text-(--fx-card-text)" aria-live="polite"></div>

							<div class="mt-3">
								<label for="terminal-input" class="sr-only">Interactive terminal input</label>
								<input id="terminal-input" placeholder="type 'help' and press Enter" class="w-full rounded-md border border-(--fx-card-border) bg-transparent px-3 py-2 text-sm text-(--fx-card-text) focus:outline-none" />
							</div>

							<div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-4">
								<button type="button" data-cmd="help" class="w-full rounded-md border border-(--fx-card-border) bg-[color-mix(in_oklch,var(--fx-bg-start)_6%,transparent)] hover:bg-(--fx-card-bg-hover) transition duration-500 px-3 py-2 text-sm">
									help
								</button>
								<button type="button" data-cmd="status" class="w-full rounded-md border border-(--fx-card-border) bg-[color-mix(in_oklch,var(--fx-bg-start)_6%,transparent)] hover:bg-(--fx-card-bg-hover) transition duration-500 px-3 py-2 text-sm">
									status
								</button>
								<button type="button" data-cmd="home" class="w-full rounded-md border border-(--fx-card-border) bg-[color-mix(in_oklch,var(--fx-bg-start)_6%,transparent)] hover:bg-(--fx-card-bg-hover) transition duration-500 px-3 py-2 text-sm">
									home
								</button>
								<button type="button" data-cmd="random" class="w-full rounded-md border border-(--fx-card-border) bg-[color-mix(in_oklch,var(--fx-bg-start)_6%,transparent)] hover:bg-(--fx-card-bg-hover) transition duration-500 px-3 py-2 text-sm">
									random
								</button>
							</div>
						</div>
					</div>

					<div class="mt-6 rounded-2xl border border-(--fx-card-border) bg-(--fx-card-bg) p-4">
						<p class="text-sm font-medium text-(--fx-card-text)" data-i18n="404.quick_exit_title">
							{translations.quickExitTitle}
						</p>
						<p class="mt-2 text-sm leading-7 text-(--fx-card-text)" data-i18n="404.quick_exit_body">
							{translations.quickExitBody}
						</p>
					</div>
				</div>
			</aside>
		</div>
	</section>

	<script>
		import { i18nData as sharedI18nData, linksData as sharedLinksData } from "@shared/config";

		type TranslationMap = Record<string, Record<string, string>>;
		type LinkRecord = {
			href: string;
			disabled?: boolean;
		};

		const i18nData = sharedI18nData.translations as TranslationMap;
		const fallbackLanguage = Object.keys(i18nData)[0] ?? "uk";
		const LINKS = ((sharedLinksData?.links ?? []) as LinkRecord[]).filter((link) => !link.disabled);

		function normalizeLanguageTag(tag: string) {
			return tag.trim().toLowerCase().replaceAll("_", "-");
		}

		function getSupportedLanguage(tag: string) {
			const normalized = normalizeLanguageTag(tag);

			if (i18nData[normalized]) {
				return normalized;
			}

			const primaryTag = normalized.split("-")[0] ?? "";
			return primaryTag && i18nData[primaryTag] ? primaryTag : null;
		}

		function getActiveLanguage() {
			const storedLanguage = window.localStorage.getItem("language");
			const documentLanguage = document.documentElement.lang;
			const candidates = [storedLanguage, documentLanguage, ...window.navigator.languages];

			for (const candidate of candidates) {
				if (!candidate) continue;

				const supportedLanguage = getSupportedLanguage(candidate);
				if (supportedLanguage) {
					return supportedLanguage;
				}
			}

			return fallbackLanguage;
		}

		function translate(language: string) {
			const localizedStrings = i18nData[language] ?? i18nData[fallbackLanguage] ?? {};

			document.querySelectorAll<HTMLElement>("[data-i18n]").forEach((element) => {
				const key = element.dataset.i18n;

				if (!key) return;

				element.textContent = localizedStrings[key] ?? key;
			});
		}

		const updateTranslations = () => translate(getActiveLanguage());

		updateTranslations();

		const observer = new MutationObserver(updateTranslations);
		observer.observe(document.documentElement, {
			attributes: true,
			attributeFilter: ["lang"],
		});

		window.addEventListener("storage", (event) => {
			if (event.key === "language") {
				updateTranslations();
			}
		});

		window.addEventListener("load", () => {
			const out = document.getElementById("terminal-output") as HTMLDivElement | null;
			const input = document.getElementById("terminal-input") as HTMLInputElement | null;
			const buttons = document.querySelectorAll<HTMLElement>('#fake-terminal [data-cmd]');

			function writeLine(text: string) {
				if (!out) return;
				const el = document.createElement("div");
				el.textContent = text;
				out.appendChild(el);
				out.scrollTop = out.scrollHeight;
			}

			function runCommand(cmd: string) {
				switch (cmd.trim().toLowerCase()) {
					case "help":
						writeLine("Available commands: help, status, home, random");
						writeLine("Try: \"status\" to inspect this page, or \"home\" to go back.");
						break;
					case "status": {
						const statusText = document.querySelector('[data-i18n="404.console_status"]')?.textContent || "Status unknown";
						writeLine(statusText);
						break;
					}
					case "home":
						writeLine("Opening homepage...");
						setTimeout(() => {
							location.href = "/";
						}, 220);
						break;
					case "random": {
						if (!Array.isArray(LINKS) || LINKS.length === 0) {
							writeLine("No links available.");
							break;
						}

						const idx = Math.floor(Math.random() * LINKS.length);
						const randomLink = LINKS[idx];
						if (!randomLink) {
							writeLine("No links available.");
							break;
						}

						const href = randomLink.href;
						writeLine(`Opening random link: ${href}`);

						try {
							window.open(href, "_blank", "noopener");
						} catch {
							location.href = href;
						}

						break;
					}
					default:
						writeLine(`Unknown command: ${cmd}`);
				}
			}

			buttons.forEach((button) => {
				button.addEventListener("click", () => {
					const cmd = button.dataset.cmd;
					if (!cmd) return;
					writeLine(`> ${cmd}`);
					runCommand(cmd);
				});
			});

			const secondaryBtn = document.getElementById("secondary-action");
			secondaryBtn?.addEventListener("click", () => {
				runCommand("random");
			});

			input?.addEventListener("keydown", (event) => {
				if (event.key !== "Enter") return;
				const value = input.value.trim();
				if (!value) return;
				writeLine(`> ${value}`);
				runCommand(value);
				input.value = "";
			});

			const pathText = document.querySelector('[data-i18n="404.console_path"]')?.textContent;
			const hintText = document.querySelector('[data-i18n="404.console_hint"]')?.textContent;
			if (pathText) writeLine(pathText);
			if (hintText) writeLine(hintText);
			writeLine("Type 'help' to get started.");
		});
	</script>

	<style>
		.scrollAnimated.delay-150 {
			transition-delay: 150ms;
		}
	</style>
</BaseLayout>
