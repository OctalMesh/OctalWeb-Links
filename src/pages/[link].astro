---
import BaseLayout from "@app/layouts/base-layout.astro";
import { redirects } from "@entities/social";

export function getStaticPaths() {
  return Object.entries(redirects).map(([link, redirect]) => ({
    params: { link },
    props: { redirect },
  }));
}

const { redirect } = Astro.props;
---

<BaseLayout description={redirect.description} title={redirect.title}>
  <main class="mx-auto flex min-h-screen w-full max-w-3xl items-center justify-center px-6">
    <article class="bento-card w-full max-w-xl p-8 text-center">
      <p class="spec-label text-xs text-zinc-500">REDIRECT</p>
      <h1 class="mt-3 text-2xl font-semibold text-zinc-100">{redirect.title}</h1>
      <p class="mt-2 text-sm text-zinc-500">{redirect.description}</p>
      <a class="mt-7 inline-flex rounded-md border border-zinc-800 px-5 py-2 text-sm text-zinc-300" href={redirect.href}>
        Continue
      </a>
    </article>
  </main>
  <meta content={`0;url=${redirect.href}`} http-equiv="refresh" />
</BaseLayout>
