---
import BaseLayout from "@app/layouts/base-layout.astro";
import { DEFAULT_LANGUAGE } from "@features/i18n/model/types";
import { getContent, projectConfig } from "@features/links/model";
import { siteConfig } from "@shared/config/site";

export function getStaticPaths() {
  return projectConfig.links.map((redirect) => ({
    params: { link: redirect.id },
    props: { redirect },
  }));
}

const { redirect } = Astro.props;
const title = getContent(redirect.title, DEFAULT_LANGUAGE);
const description =
  getContent(redirect.description, DEFAULT_LANGUAGE) ||
  `${title} on ${siteConfig.name}. This redirect page provides a quick, accessible handoff to the official destination while preserving a crawlable, multilingual link directory.`;

const profileSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  name: title,
  url: Astro.url.href,
  description,
  mainEntity: {
    "@type": "Organization",
    name: siteConfig.name,
    url: siteConfig.canonical,
  },
};
---

<BaseLayout description={description} jsonLd={profileSchema} title={title}>
  <main class="mx-auto flex min-h-screen w-full max-w-3xl items-center justify-center px-6">
    <article class="w-full max-w-xl p-8 text-center">
      <p class="spec-label text-xs text-zinc-500">REDIRECT</p>
      <h1 class="mt-3 text-2xl font-semibold text-zinc-100">{title}</h1>
      <p class="mt-2 text-sm text-zinc-500">{description}</p>
      <a class="mt-7 inline-flex rounded-md border border-zinc-800 px-5 py-2 text-sm text-zinc-300" href={redirect.href}>
        Continue
      </a>
    </article>
  </main>
  <meta content={`0;url=${redirect.href}`} http-equiv="refresh" />
</BaseLayout>
