# ============================================================================ #
# This file ships with the repository and defines default runtime values.      #
# Copy it to .env and adjust values for your local setup.                      #
#                                                                              #
# .env.example is tracked in git and loaded as default config.                 #
# .env         is intended for local overrides.                                #
# ============================================================================ #

# Default binary name for CLI commands when --name/-n is omitted.
ADMIRAL_BINARY_NAME=owl

# Default CLI source directory for commands when --src/-s is omitted.
# When empty, falls back to './' from the current working directory.
ADMIRAL_SOURCE_DIR=./cli

# Output directory for cross-platform 'build' artifacts when --out/-o is omitted.
# When empty, falls back to './build' from the current working directory.
ADMIRAL_BUILD_DIR=./cli/build

# Destination directory for CLI's 'install'/'uninstall' when --dir/-d is omitted.
# When empty, falls back to '$HOME/.local/bin'.
ADMIRAL_INSTALL_DIR=
