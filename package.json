{
  "name": "octalweb-links",
  "version": "26.7.2",
  "description": "The OctalMesh hub for socials and contacts",
  "author": "OctalMesh <contact@octalmesh.com> (https://octalmesh.com)",
  "license": "MIT",
  "homepage": "https://links.octalmesh.com",
  "type": "module",
  "private": true,
  "keywords": [
    "octalmesh",
    "octalweb",
    "links"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OctalMesh/OctalWeb-Links.git"
  },
  "bugs": {
    "url": "https://github.com/OctalMesh/OctalWeb-Links/issues",
    "email": "security@octalmesh.com"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.16.0",
    "pnpm": ">=11.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.16.0",
      "onFail": "warn"
    }
  },
  "scripts": {
    "dev": "astro dev --host",
    "staging": "astro build && astro preview --host",
    "build": "astro build",
    "preview": "astro preview --host",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "deps": "ncu -i --format group",
    "deps:check": "ncu --format group",
    "deps:minor": "ncu -i --target minor",
    "deps:patch": "ncu -i --target patch",
    "deps:doctor": "ncu --doctor -u",
    "deps:peer": "ncu --peer",
    "tree": "treee -I \"node_modules|.git|.idea|target|build|dist|dev-dist|bin|.project-structure.txt\" -a --dirs-first",
    "tree:export": "pnpm run tree --silent > .project-structure.txt"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@base-ui/react": "^1.7.0",
    "@tabler/icons-react": "^3.46.0",
    "astro": "^7.2.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion": "^12.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.3",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/estree": "^1.0.9",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.11.0",
    "jiti": "^2.7.0",
    "npm-check-updates": "^23.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.16.0",
    "tailwindcss": "^4.3.3",
    "tree-node-cli": "^3.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
